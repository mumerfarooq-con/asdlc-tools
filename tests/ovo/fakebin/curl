#!/usr/bin/env bash
# Test stand-in for curl. Appends its argv (one argument per line, then "--end--") to
# $FAKECURL_LOG (with whether the token is in its environment) and what it reads from stdin for "--config -" to $FAKECURL_STDIN_LOG, then answers
# like a server: the next code from $FAKECURL_CODES (space-separated, one per call; default 200)
# with $FAKECURL_BODY, or fails like curl with $FAKECURL_EXIT. Nothing here touches the network.
[ -n "${FAKECURL_LOG:-}" ] || { echo "fake curl: set FAKECURL_LOG" >&2; exit 99; }
{ for a in "$@"; do printf '%s\n' "$a"; done
  echo "env: BITBUCKET_TOKEN=${BITBUCKET_TOKEN:+set} BITBUCKET_EMAIL=${BITBUCKET_EMAIL:+set}"; echo "--end--"; } >> "$FAKECURL_LOG"
out=""; write_fmt=""; cfg_stdin=0; prev=""
for a in "$@"; do
  case "$prev" in -o) out="$a" ;; -w) write_fmt="$a" ;; --config|-K) [ "$a" = - ] && cfg_stdin=1 ;; esac
  prev="$a"
done
if [ "$cfg_stdin" = 1 ]; then cat >> "${FAKECURL_STDIN_LOG:-/dev/null}"; echo "--end--" >> "${FAKECURL_STDIN_LOG:-/dev/null}"; fi
n="$(grep -c '^--end--$' "$FAKECURL_LOG")"
code="$(printf '%s\n' ${FAKECURL_CODES:-200} | sed -n "${n}p")"; [ -n "$code" ] || code="$(printf '%s\n' ${FAKECURL_CODES:-200} | tail -n1)"
rc="${FAKECURL_EXIT:-0}"
if [ "$rc" -ne 0 ]; then echo "curl: ($rc) simulated failure" >&2; [ -n "$write_fmt" ] && printf '000'; exit "$rc"; fi
empty='{}'
[ -n "$out" ] && printf '%s' "${FAKECURL_BODY:-$empty}" > "$out"
[ -n "$write_fmt" ] && printf '%s' "$code"
exit 0
